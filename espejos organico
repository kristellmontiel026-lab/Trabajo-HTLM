<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Configurador - Espejo Orgánico</title>
    <!-- Librería Leaflet para el Mapa Interactivo -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        /* Declaración e Integración de Tipografías */
        @font-face {
            font-family: 'Microsoft Uighur Custom';
            src: local('Microsoft Uighur');
        }
        @font-face {
            font-family: 'MS PMincho Custom';
            src: local('MS PMincho');
        }

        /* Paleta de Colores Orgánica & Ecológica */
        :root {
            --color-dark-brown: #40271E;
            --color-medium-brown: #735443;
            --color-warm-accent: #BF9169;
            --color-soft-sand: #BFB8AE;
            --color-light-cream: #D9B88F;
            --bg-page: #f9f7f3;
            --card-bg: #ffffff;
        }

        body {
            font-family: 'MS PMincho Custom', 'MS PMincho', serif;
            background-color: var(--bg-page);
            color: var(--color-dark-brown);
            margin: 0;
            padding: 20px;
            line-height: 1.6;
        }

        /* Reglas Tipográficas */
        h1, h2, h3, h4, .title-font {
            font-family: 'Microsoft Uighur Custom', 'Microsoft Uighur', serif;
            color: var(--color-dark-brown);
            margin-top: 0;
            font-weight: normal;
        }

        h1 { font-size: 4rem; line-height: 0.85; margin-bottom: 12px; }
        h2 { font-size: 3.2rem; line-height: 0.85; border-bottom: 2px solid var(--color-light-cream); padding-bottom: 6px; }
        h3 { font-size: 2.4rem; line-height: 0.85; }

        /* Maquetación del Contenedor */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1fr;
            gap: 25px;
        }

        @media(min-width: 900px) {
            .container { grid-template-columns: 1fr 1fr; }
            .full-width { grid-column: span 2; }
        }

        .card {
            background: var(--card-bg);
            border-radius: 16px;
            padding: 25px;
            box-shadow: 0 4px 15px rgba(64, 39, 30, 0.05);
            border: 1px solid var(--color-soft-sand);
        }

        /* Galería / Catálogo de Espejos */
        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
            margin-top: 15px;
        }

        .gallery-item {
            border: 1px solid var(--color-soft-sand);
            border-radius: 12px;
            overflow: hidden;
            text-align: center;
            background: #fdfbf7;
            padding: 12px;
            transition: transform 0.2s ease;
        }

        .gallery-item:hover {
            transform: translateY(-4px);
        }

        .gallery-item img {
            width: 100%;
            height: 220px;
            object-fit: cover;
            border-radius: 8px;
        }

        .gallery-item p {
            margin: 10px 0 4px 0;
            font-weight: bold;
            color: var(--color-medium-brown);
        }

        .gallery-item span {
            font-size: 0.85rem;
            color: #555;
        }

        /* Estilos de Controles de Entrada */
        .form-group {
            margin-bottom: 18px;
        }

        .address-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 10px;
        }

        @media(min-width: 600px) {
            .address-grid { grid-template-columns: 1fr 1fr; }
            .address-grid .full-span { grid-column: span 2; }
        }

        label {
            display: block;
            margin-bottom: 6px;
            font-weight: bold;
            color: var(--color-medium-brown);
        }

        select, input[type="number"], input[type="text"] {
            width: 100%;
            padding: 12px;
            border: 1px solid var(--color-soft-sand);
            border-radius: 8px;
            font-family: inherit;
            font-size: 1rem;
            background-color: #fdfbf7;
            color: var(--color-dark-brown);
            box-sizing: border-box;
        }

        select:focus, input[type="number"]:focus, input[type="text"]:focus {
            outline: none;
            border-color: var(--color-warm-accent);
        }

        /* Opciones de Método de Pago */
        .payment-options {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-top: 8px;
        }

        .payment-card {
            border: 2px solid var(--color-soft-sand);
            border-radius: 10px;
            padding: 15px;
            text-align: center;
            cursor: pointer;
            background: #fdfbf7;
            transition: all 0.2s ease;
        }

        .payment-card:hover {
            border-color: var(--color-warm-accent);
        }

        .payment-card.active {
            border-color: var(--color-medium-brown);
            background-color: #f3ece4;
            font-weight: bold;
        }

        .card-details {
            display: none;
            margin-top: 15px;
            padding: 15px;
            background: #f8f4ee;
            border-radius: 10px;
            border: 1px dashed var(--color-medium-brown);
        }

        /* Visualizador de Precio */
        .price-display {
            background: linear-gradient(135deg, #fdfbf7, var(--color-light-cream));
            padding: 20px;
            border-radius: 12px;
            text-align: center;
            margin-top: 15px;
            border: 1px solid var(--color-soft-sand);
        }

        .price-display .amount {
            font-size: 3.2rem;
            font-family: 'Microsoft Uighur Custom', 'Microsoft Uighur', serif;
            color: var(--color-dark-brown);
            line-height: 1;
        }

        /* Tabla de Descuento */
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 12px;
        }

        th, td {
            border: 1px solid var(--color-soft-sand);
            padding: 10px;
            text-align: left;
        }

        th {
            background-color: var(--color-light-cream);
            color: var(--color-dark-brown);
        }

        .discount-badge {
            background-color: var(--color-medium-brown);
            color: #ffffff;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.85rem;
            display: inline-block;
            margin-top: 8px;
        }

        /* Mapa Interactivo */
        #map {
            height: 300px;
            width: 100%;
            border-radius: 12px;
            margin-top: 15px;
            border: 1px solid var(--color-soft-sand);
        }

        .search-btn {
            background-color: var(--color-warm-accent);
            color: white;
            border: none;
            padding: 12px 15px;
            border-radius: 8px;
            cursor: pointer;
            margin-top: 10px;
            font-family: inherit;
            font-size: 1rem;
            width: 100%;
            font-weight: bold;
        }

        .search-btn:hover {
            background-color: var(--color-medium-brown);
        }

        /* Botones Acción */
        .btn {
            background-color: var(--color-medium-brown);
            color: #ffffff;
            border: none;
            padding: 14px 20px;
            font-size: 1.1rem;
            border-radius: 8px;
            cursor: pointer;
            width: 100%;
            transition: background 0.3s;
            font-family: inherit;
        }

        .btn:hover {
            background-color: var(--color-dark-brown);
        }

        /* Chat Rastreabilidad IA */
        .chat-box {
            background: #fdfbf7;
            border: 1px solid var(--color-soft-sand);
            border-radius: 8px;
            height: 140px;
            overflow-y: auto;
            padding: 12px;
            margin-top: 10px;
            font-size: 0.9rem;
        }

        .chat-msg.bot {
            color: var(--color-medium-brown);
            font-weight: bold;
            margin-bottom: 6px;
        }

        /* Formato de Ticket Impreso */
        #ticket {
            display: none;
            background: #fff;
            border: 2px dashed var(--color-medium-brown);
            padding: 20px;
            margin-top: 20px;
            font-family: monospace;
            border-radius: 8px;
        }

        .location-info {
            font-size: 0.9rem;
            background: #fdfbf7;
            padding: 12px;
            border-left: 4px solid var(--color-warm-accent);
            border-radius: 4px;
            margin-bottom: 15px;
        }

        @media print {
            body * { visibility: hidden; }
            #ticket, #ticket * { visibility: visible; }
            #ticket {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
                border: none;
            }
        }
    </style>
</head>
<body>

<div class="container">

    <!-- Sección Descripción -->
    <div class="card full-width">
        <h1>Espejo Orgánico Flotante</h1>
        <p><strong>Espejo Orgánico flotante con luces indirectas:</strong> Transforma tu espacio con este espejo moderno y chic. Su diseño flotante crea una apariencia sutil, mientras que las luces indirectas añaden una suave luminosidad que eleva la atmósfera de cualquier habitación o recibidor de tu hogar. La fusión de funcionalidad y estilo se refleja en cada detalle de este espejo, convirtiéndolo en un elemento imprescindible para aquellos que buscan un toque de elegancia en su hogar.</p>
        <p>Experimenta la fusión perfecta de forma y función al incorporar estos elementos en tu hogar.</p>
    </div>

    <!-- Catálogo de Modelos -->
    <div class="card full-width">
        <h2>Modelos y Diseños Disponibles</h2>
        <div class="gallery-grid">
            <div class="gallery-item">
                <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTSn_3mk_Y20_t8p_P2AYziFCSSHd7fLpYAVJFKmIkfmw&s=10" alt="Espejo con Margen de Madera">
                <p>Margen de Madera Ecológica</p>
                <span>Largo: 120 cm | Ancho: 60 cm</span>
            </div>
            <div class="gallery-item">
                <img src="https://mangatta.mx/cdn/shop/files/DECORATIVO-ADHARA-LUZ-CALIDA.jpg?v=1726216329" alt="Espejo con Luces LED">
                <p>Margen con Luces LED</p>
                <span>Largo: 130 cm | Ancho: 70 cm</span>
            </div>
            <div class="gallery-item">
                <img src="https://cdn.daramio.com/blog/img/organicke_3.jpg?width=800" alt="Espejo Sin Margen">
                <p>Sin Margen (Biselado)</p>
                <span>Largo: 100 cm | Ancho: 50 cm</span>
            </div>
        </div>
    </div>

    <!-- Personalizador Dinámico -->
    <div class="card">
        <h2>Configurador Dinámico</h2>
        
        <div class="form-group">
            <label for="shape">Forma del Espejo:</label>
            <select id="shape" onchange="calculatePrice()">
                <option value="Gota">Gota</option>
                <option value="Amorfo">Amorfo (+ $150)</option>
                <option value="Río">Río (+ $250)</option>
            </select>
        </div>

        <div class="form-group">
            <label for="size">Tamaño:</label>
            <select id="size" onchange="calculatePrice()">
                <option value="Chico">Chico (60 x 40 cm)</option>
                <option value="Mediano" selected>Mediano (100 x 60 cm)</option>
                <option value="Grande">Grande (140 x 80 cm)</option>
            </select>
        </div>

        <div class="form-group">
            <label for="frame">Acabado del Margen:</label>
            <select id="frame" onchange="calculatePrice()">
                <option value="Sin margen">Sin margen</option>
                <option value="Madera ecológica">Madera ecológica (+ $450)</option>
                <option value="Luces LED indirectas" selected>Luces LED indirectas (+ $850)</option>
            </select>
        </div>

        <div class="form-group">
            <label for="quantity">Cantidad de Piezas:</label>
            <input type="number" id="quantity" value="1" min="1" onchange="calculatePrice()">
        </div>

        <div class="price-display">
            <span>Precio Unitario Calculado:</span>
            <div class="amount" id="unit-price">$0.00</div>
            <div id="bulk-alert" style="display:none;" class="discount-badge">¡Precios especiales de mayoreo aplicados!</div>
        </div>

        <!-- Tabla Ahorro Mayoreo -->
        <div style="margin-top: 15px;">
            <h3>Ahorro por Mayoreo (&ge; 6 Piezas)</h3>
            <table>
                <thead>
                    <tr>
                        <th>Categoría</th>
                        <th>Importe</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Subtotal Estándar</td>
                        <td id="table-regular">$0.00</td>
                    </tr>
                    <tr>
                        <td>Subtotal con Mayoreo (15% Desc)</td>
                        <td id="table-wholesale">$0.00</td>
                    </tr>
                    <tr>
                        <td><strong>Ahorro Directo Obtenido</strong></td>
                        <td id="table-savings" style="color: var(--color-medium-brown); font-weight: bold;">$0.00</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Envío y Tarificador Automático por Carretera -->
    <div class="card">
        <h2>Simulador de Ruta & Envíos por Carretera</h2>
        <div class="location-info">
            <strong>Ubicación de Salida (Almacén):</strong><br>
            Av Paseo de los Leones 9203-L101, 64346 Monterrey, N.L.
        </div>

        <!-- Campos de Dirección Exacta -->
        <div class="form-group">
            <label>Dirección Exacta de Entrega:</label>
            <div class="address-grid">
                <div class="full-span">
                    <input type="text" id="street" placeholder="Calle y Número (Ej. Av. Constitución 500)" value="Av. Constitución 500">
                </div>
                <div>
                    <input type="text" id="neighborhood" placeholder="Colonia (Ej. Centro)" value="Centro">
                </div>
                <div>
                    <input type="text" id="city-state" placeholder="Ciudad y Estado" value="Monterrey, N.L.">
                </div>
            </div>
            <button class="search-btn" onclick="calculateRouteFromAddress()">🚚 Ubicar Dirección y Calcular Ruta</button>
        </div>

        <div id="route-status" style="font-size: 0.9rem; color: var(--color-medium-brown); margin-bottom: 10px;"></div>

        <div>
            <p>Distancia Real por Carretera: <strong id="road-distance">0.0 km</strong></p>
            <p>Flete Base ($15.00/km): <span id="ship-base">$0.00</span></p>
            <p>IVA (16%): <span id="ship-tax">$0.00</span></p>
            <p><strong>Costo Total Envío: <span id="ship-total">$0.00</span></strong></p>
        </div>

        <div id="map"></div>
    </div>

    <!-- Método de Pago y Checkout -->
    <div class="card full-width">
        <h2>Método de Pago & Confirmación</h2>
        
        <div class="form-group">
            <label>Selecciona tu Forma de Pago:</label>
            <div class="payment-options">
                <div class="payment-card active" id="pay-cash" onclick="selectPaymentMethod('Efectivo')">
                    💵 Efectivo (Contra Entrega / Depósito)
                </div>
                <div class="payment-card" id="pay-card" onclick="selectPaymentMethod('Tarjeta')">
                    💳 Tarjeta de Crédito / Débito
                </div>
            </div>
        </div>

        <!-- Detalles opcionales para Pago con Tarjeta -->
        <div class="card-details" id="card-fields">
            <div class="form-group">
                <label for="card-num">Número de Tarjeta (Ficticio):</label>
                <input type="text" id="card-num" placeholder="**** **** **** 1234">
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                <div class="form-group">
                    <label for="card-exp">Expiración:</label>
                    <input type="text" id="card-exp" placeholder="MM/AA">
                </div>
                <div class="form-group">
                    <label for="card-cvv">CVV:</label>
                    <input type="text" id="card-cvv" placeholder="123">
                </div>
            </div>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; margin-top: 20px;">
            <div>
                <h3>Total a Pagar (Producto + Flete):</h3>
                <h1 id="grand-total" style="color: var(--color-medium-brown); margin: 0;">$0.00 MXN</h1>
            </div>
            <div style="min-width: 240px; margin-top: 10px;">
                <button class="btn" onclick="processPayment()">Confirmar Pedido Ficticio</button>
            </div>
        </div>

        <!-- Módulo IA y Tracking -->
        <div id="tracking-panel" style="display: none; border-top: 2px solid var(--color-soft-sand); margin-top: 20px; padding-top: 15px;">
            <h3>Seguimiento de Orden asistido por IA</h3>
            <p><strong>Número de Guía:</strong> <span id="tracking-number" style="font-family: monospace; font-weight: bold; background: var(--color-light-cream); padding: 4px 8px; border-radius: 4px;"></span></p>
            
            <div class="chat-box" id="chat-box">
                <div class="chat-msg bot">IA Logística: Transacción confirmada. Asignando ruta de envío desde Monterrey, N.L...</div>
            </div>

            <button class="btn" style="margin-top: 15px; background-color: var(--color-dark-brown);" onclick="printTicket()">Imprimir Recibo de Compra</button>
        </div>

        <!-- Plantilla Recibo -->
        <div id="ticket">
            <h2 style="text-align: center; border: none; margin-bottom: 0;">RECIBO DE COMPRA - ESPEJO ORGÁNICO</h2>
            <p style="text-align: center; font-size: 0.8rem; margin-top: 0;">Origen: Av Paseo de los Leones 9203-L101, 64346 Monterrey, N.L.</p>
            <hr>
            <p><strong>No. Guía:</strong> <span id="ticket-guide"></span></p>
            <p><strong>Método de Pago:</strong> <span id="ticket-payment" style="font-weight: bold;"></span></p>
            <p><strong>Dirección Entrega:</strong> <span id="ticket-address"></span></p>
            <p><strong>Distancia Recorrida:</strong> <span id="ticket-dist"></span></p>
            <p><strong>Forma:</strong> <span id="ticket-shape"></span> | <strong>Tamaño:</strong> <span id="ticket-size"></span></p>
            <p><strong>Margen:</strong> <span id="ticket-frame"></span> | <strong>Cantidad:</strong> <span id="ticket-qty"></span></p>
            <hr>
            <p>Subtotal Productos: <span id="ticket-subtotal"></span></p>
            <p>Flete e IVA: <span id="ticket-shipping"></span></p>
            <h3>TOTAL CANCELADO: <span id="ticket-total"></span></h3>
            <hr>
            <p style="text-align: center; margin-bottom: 0;">¡Gracias por adquirir diseño sustentable!</p>
        </div>

    </div>

</div>

<!-- Librería JS Leaflet -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
    let currentUnitPrice = 0;
    let currentProductTotal = 0;
    let currentShippingTotal = 0;
    let currentGrandTotal = 0;
    let currentKm = 0;
    let selectedPayment = 'Efectivo';

    // Coordenadas Origen: Paseo de los Leones 9203, Monterrey
    const originCoords = [25.7248, -100.3983];
    const map = L.map('map').setView(originCoords, 11);
    
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap'
    }).addTo(map);

    // Marcador Almacén Origen
    L.marker(originCoords).addTo(map)
        .bindPopup('<b>Almacén Origen:</b><br>Paseo de los Leones 9203, Monterrey')
        .openPopup();

    let destMarker, routePathLayer;

    // Selector de Método de Pago
    function selectPaymentMethod(method) {
        selectedPayment = method;
        const cashCard = document.getElementById('pay-cash');
        const cardCard = document.getElementById('pay-card');
        const cardFields = document.getElementById('card-fields');

        if (method === 'Efectivo') {
            cashCard.classList.add('active');
            cardCard.classList.remove('active');
            cardFields.style.display = 'none';
        } else {
            cardCard.classList.add('active');
            cashCard.classList.remove('active');
            cardFields.style.display = 'block';
        }
    }

    // Precios Psicológicos (.95 / .90)
    function applyPsychologicalPrice(rawPrice, ending) {
        return Math.floor(rawPrice) + (ending === 90 ? 0.90 : 0.95);
    }

    // Cálculo del Producto
    function calculatePrice() {
        const shape = document.getElementById('shape').value;
        const size = document.getElementById('size').value;
        const frame = document.getElementById('frame').value;
        const qty = parseInt(document.getElementById('quantity').value) || 1;

        let base = 1200;
        if (size === 'Mediano') base = 1800;
        if (size === 'Grande') base = 2600;

        if (shape === 'Amorfo') base += 150;
        if (shape === 'Río') base += 250;

        if (frame === 'Madera ecológica') base += 450;
        if (frame === 'Luces LED indirectas') base += 850;

        let unitPrice = applyPsychologicalPrice(base, 95);
        let regularTotal = unitPrice * qty;
        let finalTotal = regularTotal;

        const bulkAlert = document.getElementById('bulk-alert');

        if (qty >= 6) {
            let discountedUnit = applyPsychologicalPrice(unitPrice * 0.85, 90);
            finalTotal = discountedUnit * qty;
            bulkAlert.style.display = 'inline-block';
            
            document.getElementById('table-regular').innerText = `$${regularTotal.toFixed(2)} MXN`;
            document.getElementById('table-wholesale').innerText = `$${finalTotal.toFixed(2)} MXN`;
            document.getElementById('table-savings').innerText = `$${(regularTotal - finalTotal).toFixed(2)} MXN`;
        } else {
            bulkAlert.style.display = 'none';
            document.getElementById('table-regular').innerText = `$${regularTotal.toFixed(2)} MXN`;
            document.getElementById('table-wholesale').innerText = `$${regularTotal.toFixed(2)} MXN`;
            document.getElementById('table-savings').innerText = `$0.00 MXN`;
        }

        currentUnitPrice = unitPrice;
        currentProductTotal = finalTotal;

        document.getElementById('unit-price').innerText = `$${unitPrice.toFixed(2)}`;
        updateGrandTotal();
    }

    // Geocodificación Precisa y Ruta por Carretera
    async function calculateRouteFromAddress() {
        const street = document.getElementById('street').value.trim();
        const neighborhood = document.getElementById('neighborhood').value.trim();
        const cityState = document.getElementById('city-state').value.trim();
        const statusDiv = document.getElementById('route-status');

        if (!street || !cityState) {
            statusDiv.innerHTML = "<span style='color:red;'>Por favor ingresa al menos la Calle/Número y la Ciudad.</span>";
            return;
        }

        // Construir la consulta detallada
        const fullAddress = `${street}, ${neighborhood ? neighborhood + ', ' : ''}${cityState}`;
        statusDiv.innerHTML = "🔍 Buscando calle y colonia exactas para trazar ruta...";

        try {
            // 1. Geocodificar la dirección detallada
            const geoUrl = `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(fullAddress)}`;
            const geoRes = await fetch(geoUrl);
            const geoData = await geoRes.json();

            if (!geoData || geoData.length === 0) {
                statusDiv.innerHTML = "<span style='color:red;'>No se encontró la ubicación exacta. Verifica la calle y colonia ingresadas.</span>";
                return;
            }

            const destLat = parseFloat(geoData[0].lat);
            const destLon = parseFloat(geoData[0].lon);

            // 2. Obtener la ruta exacta por carreteras (OSRM)
            const osrmUrl = `https://router.project-osrm.org/route/v1/driving/${originCoords[1]},${originCoords[0]};${destLon},${destLat}?overview=full&geometries=geojson`;
            const routeRes = await fetch(osrmUrl);
            const routeData = await routeRes.json();

            if (!routeData.routes || routeData.routes.length === 0) {
                statusDiv.innerHTML = "<span style='color:red;'>No se pudo calcular una ruta terrestre hacia esa ubicación.</span>";
                return;
            }

            const route = routeData.routes[0];
            const distanceKm = route.distance / 1000; // Convertir metros a km
            currentKm = distanceKm;

            // 3. Dibujar la ruta en el mapa
            if (destMarker) map.removeLayer(destMarker);
            if (routePathLayer) map.removeLayer(routePathLayer);

            destMarker = L.marker([destLat, destLon]).addTo(map)
                .bindPopup(`<b>Destino de Entrega:</b><br>${fullAddress}`)
                .openPopup();

            routePathLayer = L.geoJSON(route.geometry, {
                style: { color: '#735443', weight: 5, opacity: 0.8 }
            }).addTo(map);

            map.fitBounds(routePathLayer.getBounds(), { padding: [40, 40] });

            // 4. Actualizar costos con Tarifa de $15/km
            document.getElementById('road-distance').innerText = `${distanceKm.toFixed(2)} km`;
            
            const baseRate = distanceKm * 15; // Actualizado a $15 por km
            const tax = baseRate * 0.16;
            const totalShip = baseRate + tax;

            currentShippingTotal = totalShip;

            document.getElementById('ship-base').innerText = `$${baseRate.toFixed(2)} MXN`;
            document.getElementById('ship-tax').innerText = `$${tax.toFixed(2)} MXN`;
            document.getElementById('ship-total').innerText = `$${totalShip.toFixed(2)} MXN`;

            statusDiv.innerHTML = "✅ <span style='color:green;'>Ubicación encontrada y ruta del camión trazada.</span>";
            updateGrandTotal();

        } catch (error) {
            console.error(error);
            statusDiv.innerHTML = "<span style='color:red;'>Error al consultar el servicio de mapas. Verifica tu conexión.</span>";
        }
    }

    function updateGrandTotal() {
        currentGrandTotal = currentProductTotal + currentShippingTotal;
        document.getElementById('grand-total').innerText = `$${currentGrandTotal.toFixed(2)} MXN`;
    }

    // Proceso Checkout / Simulador IA
    function processPayment() {
        const panel = document.getElementById('tracking-panel');
        const trackingNum = 'ORG-NL-' + Math.floor(100000 + Math.random() * 900000);
        
        document.getElementById('tracking-number').innerText = trackingNum;
        panel.style.display = 'block';
        panel.scrollIntoView({ behavior: 'smooth' });

        setTimeout(() => {
            appendMsg(`IA Logística: Transacción procesada correctamente mediante [${selectedPayment}].`);
        }, 1000);

        setTimeout(() => {
            appendMsg("IA Logística: Verificando empaque de seguridad y programando unidad de transporte...");
        }, 2200);

        setTimeout(() => {
            const street = document.getElementById('street').value;
            const neighborhood = document.getElementById('neighborhood').value;
            const cityState = document.getElementById('city-state').value;
            const fullAddr = `${street}, ${neighborhood ? neighborhood + ', ' : ''}${cityState}`;

            appendMsg(`IA Logística: Camión en ruta (${currentKm.toFixed(1)} km por carretera). Guía ${trackingNum} asignada hacia "${fullAddr}".`);
        }, 4000);
    }

    function appendMsg(msg) {
        const chatBox = document.getElementById('chat-box');
        const div = document.createElement('div');
        div.className = 'chat-msg bot';
        div.innerText = msg;
        chatBox.appendChild(div);
        chatBox.scrollTop = chatBox.scrollHeight;
    }

    // Imprimir Recibo
    function printTicket() {
        const street = document.getElementById('street').value;
        const neighborhood = document.getElementById('neighborhood').value;
        const cityState = document.getElementById('city-state').value;
        const fullAddr = `${street}, ${neighborhood ? neighborhood + ', ' : ''}${cityState}`;

        document.getElementById('ticket-guide').innerText = document.getElementById('tracking-number').innerText;
        document.getElementById('ticket-payment').innerText = selectedPayment;
        document.getElementById('ticket-address').innerText = fullAddr || "No especificada";
        document.getElementById('ticket-dist').innerText = `${currentKm.toFixed(2)} km`;
        document.getElementById('ticket-shape').innerText = document.getElementById('shape').value;
        document.getElementById('ticket-size').innerText = document.getElementById('size').value;
        document.getElementById('ticket-frame').innerText = document.getElementById('frame').value;
        document.getElementById('ticket-qty').innerText = document.getElementById('quantity').value;
        
        document.getElementById('ticket-subtotal').innerText = `$${currentProductTotal.toFixed(2)} MXN`;
        document.getElementById('ticket-shipping').innerText = `$${currentShippingTotal.toFixed(2)} MXN`;
        document.getElementById('ticket-total').innerText = `$${currentGrandTotal.toFixed(2)} MXN`;

        document.getElementById('ticket').style.display = 'block';
        window.print();
    }

    window.onload = function() {
        calculatePrice();
        calculateRouteFromAddress();
    };
</script>
</body>
